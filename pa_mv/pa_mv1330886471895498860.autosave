// =====================================================================
//  pa_mv.pde  -  MAIN
//  Di sini hanya: setup element + JADWAL kapan tiap element tampil.
//  Isi tiap element ada di file el_*.pde
// =====================================================================
import processing.sound.*;

final float VOLUME = 0.1;   // volume lagu (dipakai juga saat play/restart)
SoundFile lagu;
PFont fontJepang;
BeatClock clock;

// ---- daftar element ----
ElBackrooms  backrooms;
ElBackroomStatic backroomStatic;
ElBola       bola;
ElPolyrhythm poli;
ElJudul      judul;
ElLirik      lirik;
ElDebug      debug;
ElKontrol    kontrol;
ElTvStatic   tvStatic;
ElEfekVHS    efekVHS;
FxTransition transitionFx;
ElDoorLoop   doorLoop;    // cuplikan pintu looping (beat 100-103)
ElKinetik    kinetik;     // adegan lirik kinetik (beat 103-136)
FxCRT        crtFx;       // transisi layar TV mati/nyala
FxRiser      riser;       // suara naik

void setup() {
  size(1280, 720, P3D);
  //surface.setResizable(true);
  surface.setLocation(100, 50);
  pixelDensity(displayDensity());

  fontJepang = createFont("NotoSansJP-Regular.ttf", 32);
  lagu = new SoundFile(this, "assets/MainSong.mp3");
  lagu.play();
  lagu.amp(VOLUME); // buat test aja
  
  clock = new BeatClock();

  backrooms = new ElBackrooms();
  backroomStatic = new ElBackroomStatic();
  bola      = new ElBola(100);
  poli      = new ElPolyrhythm(200, 60);
  judul     = new ElJudul(fontJepang, "LOOPING THE ROOM");
  lirik     = new ElLirik(fontJepang);
  debug     = new ElDebug(fontJepang);
  kontrol   = new ElKontrol(lagu, clock);
  tvStatic  = new ElTvStatic();
  efekVHS   = new ElEfekVHS();
  transitionFx = new FxTransition();
  doorLoop  = new ElDoorLoop();
  kinetik   = new ElKinetik(fontJepang);
  crtFx     = new FxCRT();
  riser     = new FxRiser(this, 100, 103);   // suara naik: beat 100 -> 103
}

void draw() {
  clock.update(lagu.position() * 1000);
  background(0);

// ===================== 1. LATAR 3D (pilih salah satu) =====================
  // Disusun berurutan (kronologis) berdasarkan ketukan (beat) lagu
  if      (clock.inBeat(100, 103)) doorLoop.show(clock, 100);   // Beat 100-102: pintu terbuka -> ternyata loop
  else if (clock.inBeat(103, 136)) { /* latar = adegan kinetik 2D (digambar di bagian 2D) */ }
  else if (clock.inBeat(8, 22))    backrooms.show(clock, 0);  // Beat 8-21: Lorong kuning
  else if (clock.inBeat(22, 24))   backrooms.show(clock, 1);  // Beat 22-23: Lorong abu-abu
  else if (clock.inBeat(24, 40))   backroomStatic.show(clock, ((clock.beat - 24) % 4) + 1); // Beat 24-39: Ruang statis berganti-ganti
  
  // (Beat 40 - 135 akan otomatis jatuh ke 'else' di bawah, yaitu ruang statis 0)
  
  else if (clock.inBeat(136, 150)) backrooms.show(clock, 0);  // Beat 136-149: Lorong kuning
  else if (clock.inBeat(150, 152)) backrooms.show(clock, 2);  // Beat 150-151: Lorong ungu
  else if (clock.inBeat(152, 168)) backrooms.show(clock, 0);  // Beat 152-167: Lorong kuning
  
  else                             backroomStatic.show(clock, 0); // Waktu kosong / sisanya: Default (ruang statis 0)

  // ===================== 2. ELEMENT 2D (boleh numpuk/overlap) =====================
  // Urutan panggil = urutan tumpukan (yang terakhir paling depan)
  if (!clock.inBeat(100, 136)) bola.show(clock);  // bola disembunyikan di adegan pintu & kinetik
  if (clock.inBeat(0, 200)) poli.show(clock);      // beat 0-199
  
  //40,47
  if (clock.inBeat(40, 49)) {
  tvStatic.show(clock,1);
  }
 
  //46-54
  if (clock.inBeat(49, 56)) {
  tvStatic.show(clock,2);
  }
  
  //46-54
  if (clock.inBeat(56, 72)) {
  tvStatic.show(clock,3);
  efekVHS.show(clock);
  }
  
  //46-54
  if (clock.inBeat(72, 100)) {
  tvStatic.show(clock,4);
  efekVHS.show(clock);
  }


  // Adegan kinetik (video ref 0:37-0:50). Beat 103-104 masih hitam (ditutup crtFx), tulisan mulai beat 104.
  if (clock.inBeat(103, 136)) kinetik.show(clock, lirik);
  if (clock.inBeat(100, 136)) efekVHS.show(clock);  // grain/scanline di pintu & kinetik

  transitionFx.show();
  judul.show(clock);
  if (!clock.inBeat(104, 136)) lirik.show(clock);  // di beat 104-135 lirik sudah digambar besar oleh kinetik
  transitionFx.showGlitch();                       // glitch satu layar (di atas semua, di bawah UI)

  // Layar TV: MATI di akhir cuplikan pintu (102.4 -> 103.0), hitam, lalu NYALA lagi (103.7 -> 104.1)
  crtFx.show(clock, 102.4, 103.0, 103.7, 104.1);
  //riser.update(clock, kontrol.isPlaying);
  

  // ===================== 3. UI =====================
  kontrol.show();
  debug.show(clock);

  // ===================== 4. EVENT SEKALI (di sini switch cocok) =====================
  // if (clock.newBeat) {
  //   switch (clock.beat) {
  //     case 64: /* sesuatu yang cuma sekali di beat 64 */ break;
  //     case 96: /* ... */ break;
  //   }
  // }
  
  // ===================== 4. EVENT SEKALI (di sini switch cocok) =====================
  // ---- GLITCH (jadwal dalam SUBBEAT; 1 beat = 2 subbeat) ----
  if (clock.atSubBeat(142)) transitionFx.triggerGlitch();  // Beat 71  : sebelum anak muncul
  if (clock.atSubBeat(158)) transitionFx.triggerGlitch();  // Beat 79  : teleport 1
  if (clock.atSubBeat(174)) transitionFx.triggerGlitch();  // Beat 87  : teleport 2
  if (clock.atSubBeat(191)) transitionFx.triggerGlitch();  // Beat 95.5: teleport 3
  if (clock.atSubBeat(203)) transitionFx.triggerGlitch();  // Beat 101.5: titik loop pintu (ketahuan sama)
  if (clock.atSubBeat(216)) transitionFx.triggerGlitch();  // Beat 108  : masuk "くりかえす"
  if (clock.atSubBeat(240)) transitionFx.triggerGlitch();  // Beat 120  : masuk ruang bola "ふら"
  if (clock.atSubBeat(272)) transitionFx.triggerGlitch();  // Beat 136  : keluar ke lorong kuning
  // (posisi anak untuk tiap teleport diatur di el_tvstatic.pde -> boySub / boyStartX)

  if (clock.newBeat) {
    switch (clock.beat) {
      case 99: 
        transitionFx.triggerPresser();; // Ledakan flash masuk ke room 3
        break;
      case 55: 
        transitionFx.trigger(); // Ledakan flash masuk ke room 3
        break;
    }
  }
}



void mousePressed() {
  kontrol.mousePressed();
}

void keyPressed() {
  if (key == 'c' || key == 'C') kontrol.setCheckpoint();   // simpan titik RESTART di posisi sekarang
}
